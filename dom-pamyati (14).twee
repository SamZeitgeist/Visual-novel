  "zoom": 1
}

:: StoryStylesheet [stylesheet]
html, body {
	margin: 0 !important;
	padding: 0 !important;
	height: 100% !important;
	width: 100% !important;
	background-color: #0e0d10;
	color: #d8d3c8;
	font-family: Georgia, "Times New Roman", serif;
	overflow: hidden !important;
}

body {
	background-image: url("фон.jpg");
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	background-attachment: fixed;
}

tw-story {
	display: block !important;
	position: static !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	background: transparent !important;
	border: none !important;
	box-shadow: none !important;
	transform: none !important;
	overflow: visible !important;
}

tw-passage {
	position: fixed !important;
	left: 0 !important;
	right: 0 !important;
	margin: 0 auto !important;
	bottom: 1.2em !important;
	top: auto !important;
	width: 68% !important;
	max-width: 1200px !important;
	min-width: 480px !important;
	height: 22vh !important;
	min-height: 160px !important;
	box-sizing: border-box !important;
	padding: 0 !important;
	background: transparent !important;
	border: none !important;
	overflow: visible !important;
	z-index: 10 !important;
	display: block !important;
}

/* Фон/рамка/блюр — в псевдоэлементе: сам tw-passage не должен иметь
   transform или backdrop-filter, иначе он становится "containing block"
   для position:fixed потомков (.choices), и те залипают внутри
   маленького окна вместо позиционирования от экрана. */
tw-passage::before {
	content: "";
	position: absolute;
	inset: 0;
	background-color: rgba(10, 9, 11, 0.78);
	border: 1px solid rgba(184, 89, 59, 0.45);
	border-radius: 8px;
	backdrop-filter: blur(4px);
	-webkit-backdrop-filter: blur(4px);
	z-index: -1;
}

.vn-stage {
	position: absolute;
	top: 0; left: 0; right: 0; bottom: 0;
	padding: 1.2em 1.8em;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	overflow: hidden;
	z-index: 5;
}

.vn-stage .dialogue { margin: 0.2em 0; }
.vn-stage .dialogue .speaker {
	/* имя теперь показывается отдельной плашкой в углу окна (.speaker-name-tag),
	   а не внутри самой реплики */
	display: none;
}
.vn-stage .dialogue .line {
	margin: 0;
	padding: 0.5em 0.9em;
	background-color: rgba(255, 255, 255, 0.03);
	border-left: 3px solid rgba(184, 89, 59, 0.6);
}
/* Мигающий курсор, пока строка "печатается" */
.vn-stage .typing .line::after,
.vn-stage .typing.narration::after,
.vn-stage .typing.symptom::after {
	content: "▍";
	display: inline-block;
	margin-left: 2px;
	color: #b8593b;
	animation: vn-caret 0.8s steps(1) infinite;
}
@keyframes vn-caret {
	0%, 49% { opacity: 1; }
	50%, 100% { opacity: 0; }
}

/* Именная плашка — прикреплена к верхнему левому углу окна текста,
   а не к конкретной реплике */
.speaker-name-tag {
	position: absolute;
	top: -1.6em;
	left: 1.4em;
	background-color: rgba(184, 89, 59, 0.95);
	color: #0e0d10;
	font-weight: bold;
	font-variant: small-caps;
	letter-spacing: 0.5px;
	padding: 0.3em 1.1em;
	border-radius: 6px 6px 0 0;
	font-size: 0.95em;
	z-index: 20;
	display: none;
}
.vn-stage .narration {
	color: #b9b3a6;
	font-style: italic;
	margin: 0.2em 0;
}
.vn-stage h1, .vn-stage h2, .vn-stage h3 {
	color: #a5493a;
	font-variant: small-caps;
	letter-spacing: 1px;
	margin: 0.2em 0 0.4em 0;
	font-size: 1.05em;
}
.vn-stage .symptom {
	color: #7a7266;
	font-style: italic;
	font-size: 0.9em;
	border-top: 1px solid #2a2822;
	margin-top: 0.6em;
	padding-top: 0.4em;
}
.vn-stage .voice { color: #8f9bb3; font-style: italic; }

/* Кнопки выбора — появляются НАД окном, справа.
   Внутри пассажа, position: fixed работает от окна. */
.choices {
	position: fixed !important;
	right: 3em !important;
	left: auto !important;
	bottom: calc(22vh + 2.4em) !important;
	top: auto !important;
	transform: none !important;
	display: none;
	flex-direction: column !important;
	align-items: flex-end !important;
	gap: 0.5em !important;
	z-index: 30 !important;
	margin: 0 !important;
	padding: 0 !important;
	max-width: none !important;
}
.choices.vn-visible {
	display: flex !important;
}
.choices tw-link, .choices .link {
	display: block !important;
	min-width: 220px !important;
	text-align: right !important;
	color: #f2ede0 !important;
	background-color: rgba(20, 18, 22, 0.9) !important;
	text-decoration: none !important;
	border: 1px solid rgba(184, 89, 59, 0.85) !important;
	border-radius: 6px !important;
	padding: 0.6em 1.2em !important;
	font-size: 0.95em !important;
	transition: background-color 0.15s ease;
	box-sizing: border-box !important;
	margin: 0 !important;
}
.choices tw-link:hover, .choices .link:hover {
	color: #0e0d10 !important;
	background-color: rgba(184, 89, 59, 0.9) !important;
}

tw-link, .link {
	display: inline-block;
	color: #f2ede0 !important;
	background-color: rgba(42, 40, 34, 0.55);
	text-decoration: none;
	border: 1px solid rgba(184, 89, 59, 0.8);
	border-radius: 4px;
	padding: 0.5em 1.2em;
	margin: 0.4em 0.4em 0.4em 0;
	transition: background-color 0.15s ease;
}
tw-link:hover, .link:hover {
	color: #0e0d10 !important;
	background-color: rgba(184, 89, 59, 0.85);
}

tw-expression[name="link-undo"] {
	position: fixed !important;
	top: 1.2em !important;
	left: 1.2em !important;
	right: auto !important;
	bottom: auto !important;
	z-index: 100 !important;
	display: inline-block !important;
	margin: 0 !important;
}
tw-expression[name="link-undo"] tw-link,
tw-expression[name="link-undo"] .link {
	display: inline-block;
	color: #d8d3c8 !important;
	background-color: rgba(20, 18, 22, 0.85);
	border: 1px solid rgba(184, 89, 59, 0.7);
	border-radius: 6px;
	padding: 0.4em 1em;
	font-size: 0.85em;
	text-decoration: none;
	margin: 0;
}
tw-expression[name="link-undo"] tw-link:hover,
tw-expression[name="link-undo"] .link:hover {
	background-color: rgba(184, 89, 59, 0.9);
	color: #0e0d10 !important;
}

.savebtn {
	position: fixed !important;
	top: 1.2em !important;
	right: 1.2em !important;
	z-index: 100 !important;
}
.savebtn tw-link, .savebtn .link {
	font-size: 0.85em;
	padding: 0.4em 1em;
}

/* Главное меню — полноэкранная центрированная раскладка вместо
   маленького окна диалога снизу. :has() безопасно проверяет,
   что пассаж содержит .menu-screen. */
tw-passage:has(.menu-screen) {
	left: 0 !important;
	right: 0 !important;
	bottom: 0 !important;
	top: 0 !important;
	margin: 0 !important;
	width: 100% !important;
	height: 100% !important;
	max-width: none !important;
	min-width: 0 !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
}
tw-passage:has(.menu-screen)::before {
	background-color: rgba(5, 4, 6, 0.55) !important;
	border: none !important;
	border-radius: 0 !important;
}
.menu-screen {
	text-align: center;
	max-width: 560px;
	padding: 2em;
}
.menu-title {
	font-size: 3em;
	margin: 0 0 0.2em 0;
}
.menu-tagline {
	color: #b9b3a6;
	font-style: italic;
	margin-bottom: 2em;
}
.menu-buttons {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.8em;
}
.menu-buttons tw-link, .menu-buttons .link {
	font-size: 1.1em;
	min-width: 220px;
	text-align: center;
}
.menu-disabled {
	display: inline-block;
	min-width: 220px;
	box-sizing: border-box;
	text-align: center;
	padding: 0.6em 1.4em;
	color: #6b655a;
	border: 1px solid #3a352c;
	border-radius: 4px;
	cursor: not-allowed;
}
.menu-about {
	margin-top: 1em;
	max-width: 480px;
	color: #cfc9bc;
	font-size: 0.95em;
	line-height: 1.5;
	text-align: left;
}

.continue-indicator {
	position: absolute;
	bottom: 0.4em;
	right: 1em;
	color: #b8593b;
	font-size: 1.3em;
	line-height: 1;
	pointer-events: none;
	user-select: none;
	animation: vn-bounce 1.1s ease-in-out infinite;
}
@keyframes vn-bounce {
	0%, 100% { transform: translateY(0); opacity: 0.55; }
	50% { transform: translateY(6px); opacity: 1; }
}

.voice { color: #8f9bb3; font-style: italic; }
img {
	display: block;
	max-width: 100%;
	height: auto;
	margin: 1.5em auto;
	border-radius: 4px;
	box-shadow: 0 4px 18px rgba(0,0,0,0.4);
}

:: StoryJavaScript [script]
(function () {

	/* Общая ссылка на функцию, которую всегда вызывает единый обработчик
	   клика — либо "домотать" печатающийся текст мгновенно, либо перейти
	   к следующей строке. Переписывается заново при инициализации каждой
	   новой сцены (иначе клик после перехода дёргал бы старую сцену). */
	var reveal = { next: null };

	function showChoices(passageEl) {
		var el = passageEl.querySelector('.choices');
		if (el) el.classList.add('vn-visible');
	}

	function hideChoices(passageEl) {
		var list = passageEl.querySelectorAll('.choices');
		for (var i = 0; i < list.length; i++) {
			list[i].classList.remove('vn-visible');
		}
	}

	/* Печатная машинка: посимвольно выводит текст в el.
	   Возвращает объект с методом finish() — домотать мгновенно. */
	function typeText(el, speed, onDone) {
		var full = el.textContent;
		el.textContent = '';
		el.classList.add('typing');
		var i = 0;
		var timer = null;
		var done = false;

		function finish() {
			if (done) return;
			done = true;
			if (timer) { clearTimeout(timer); timer = null; }
			el.textContent = full;
			el.classList.remove('typing');
			if (onDone) onDone();
		}

		function step() {
			if (i >= full.length) { finish(); return; }
			el.textContent += full.charAt(i);
			i++;
			timer = setTimeout(step, speed);
		}
		step();

		return { finish: finish };
	}

	function setupTextbox(passageEl) {
		if (!passageEl || passageEl.dataset.vnInit === "1") return;
		passageEl.dataset.vnInit = "1";

		/* Главное меню показывается целиком и сразу — оно не проходит
		   через систему "по клику показать следующую строку". */
		if (passageEl.querySelector('.menu-screen')) {
			reveal.next = null;
			return;
		}

		var units = Array.prototype.slice.call(
			passageEl.querySelectorAll(".dialogue, .narration, .symptom, h1, h2, h3")
		);
		units.forEach(function (el) { el.style.display = 'none'; });

		var stage = document.createElement('div');
		stage.className = 'vn-stage';
		passageEl.appendChild(stage);

		/* Плашка с именем говорящего — в углу окна, отдельно от текста. */
		var nameTag = document.createElement('div');
		nameTag.className = 'speaker-name-tag';
		passageEl.appendChild(nameTag);

		var indicator = document.createElement('div');
		indicator.className = 'continue-indicator';
		indicator.textContent = '▼';
		stage.appendChild(indicator);

		hideChoices(passageEl);

		var shown = 0;
		var total = units.length;
		var typing = null;

		function afterLineReady() {
			if (shown >= total) {
				indicator.style.display = 'none';
				showChoices(passageEl);
			}
		}

		function revealNext() {
			if (shown >= total) return;

			var current = stage.querySelector('.dialogue, .narration, .symptom, h1, h2, h3');
			if (current) current.remove();

			var clone = units[shown].cloneNode(true);
			clone.style.display = '';
			stage.insertBefore(clone, indicator);
			shown++;

			var speakerEl = clone.querySelector ? clone.querySelector('.speaker') : null;
			if (speakerEl && speakerEl.textContent.trim()) {
				nameTag.textContent = speakerEl.textContent;
				nameTag.style.display = 'block';
			} else {
				nameTag.style.display = 'none';
			}

			var textTarget = null;
			if (clone.classList.contains('dialogue')) {
				textTarget = clone.querySelector('.line');
			} else if (clone.classList.contains('narration') || clone.classList.contains('symptom')) {
				textTarget = clone;
			}

			if (textTarget) {
				typing = typeText(textTarget, 22, function () {
					typing = null;
					afterLineReady();
				});
			} else {
				afterLineReady();
			}
		}

		if (total === 0) {
			showChoices(passageEl);
		} else {
			revealNext();
		}

		/* Клик во время печати — домотать строку мгновенно.
		   Клик после — перейти к следующей строке. */
		reveal.next = function () {
			if (typing) {
				typing.finish();
			} else {
				revealNext();
			}
		};
	}

	document.addEventListener('click', function (e) {
		if (e.target.closest("tw-link, .link, a, tw-expression[name='link-undo']")) return;
		if (reveal.next) reveal.next();
	});

	function onPassageAdded() {
		var passageEl = document.querySelector('tw-passage');
		if (passageEl) setupTextbox(passageEl);
	}

	var vnObserver = new MutationObserver(function (mutations) {
		mutations.forEach(function (m) {
			if (!m.addedNodes) return;
			m.addedNodes.forEach(function (node) {
				if (node.nodeType !== 1) return;
				if (node.tagName === "TW-PASSAGE" || (node.querySelectorAll && node.querySelectorAll("tw-passage").length)) {
					onPassageAdded();
				}
			});
		});
	});
	vnObserver.observe(document.body, { childList: true, subtree: true });

	$(document).on(':passagerender', function () {
		setTimeout(onPassageAdded, 0);
	});

})();


:: Header [header]
(link-undo: "← Назад")
{(if: (passage:)'s name is not "Start")[
<div class="savebtn">(link: "💾 Сохранить")[(save-game: "Slot 1", "Дом памяти")]</div>
]}

:: Start
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%BF%D1%80%D0%B5%D0%B2%D1%8C%D1%8E.jpg')";</script>

<div class="menu-screen">
	<h1 class="menu-title">ДОМ ПАМЯТИ</h1>
	<div class="menu-tagline">Интерактивная новелла по мотивам сценария психологического хоррора</div>

	<div class="menu-buttons">
		(link: "Новая игра")[(set: $readiness to 10)(set: $distortion to 10)(goto: "День1_День")]
		{(if: (saved-games:) contains "Slot 1")[
			(link: "Продолжить")[(load-game: "Slot 1")]
		](else:)[
			<span class="menu-disabled">Продолжить</span>
		]}
		(link-reveal: "Об игре")[
			<div class="menu-about">Аня Ковалёва возвращается в дом детства после смерти отца — и обнаруживает, что дом помнит то лето пятнадцатилетней давности лучше, чем она сама. Три возможных финала зависят от того, что вы готовы узнать.<br><br><i>Тема истории — травма, память и гибель ребёнка (без графических подробностей).</i></div>
		]
	</div>
</div>

:: SymptomFooter
{(if: $distortion >= 60 and $readiness >= 60)[
<div class="symptom">Комната как будто плывёт по краям, будто ты смотришь на неё сквозь мокрое стекло.</div>
](else-if: $distortion >= 55)[
<div class="symptom">На стене, кажется, прибавилась ещё одна трещина — тонкая, свежая, идущая от косяка вниз.</div>
](else-if: $readiness >= 55)[
<div class="symptom">Половицы в глубине дома чуть слышно скрипят — размеренно, как будто дом ждёт вопроса.</div>
]}

:: День1_День
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D1%80%D0%B0%D0%B7%D0%B3%D0%BE%D0%B2%D0%BE%D1%80.png')";</script>
<h2>День 1 — Приезд</h2>

<div class="narration">Аня Ковалёва, 28 лет. Отец умер три недели назад. Дом, в котором она не была пятнадцать лет, ждёт, чтобы его разобрали на коробки и продали.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Дом стоит пустой пятнадцать лет...</p></div>

<div class="narration">Ключ подходит не сразу — замок за пятнадцать лет разбух и ссохся не в такт. Внутри пахнет пылью и чем-то сладковато-лекарственным. У калитки кто-то окликает.</div>

<div class="dialogue"><span class="speaker">Марина</span><p class="line">Аня?</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Марина... Господи, сколько лет.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Ты совсем не изменилась.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Ты тоже.</p></div>

<div class="narration">Она ни разу не произносит имя Лизы. Ты тоже.</div>

<div class="choices">
(link-goto: "Ответить тепло, разговориться подробнее", "День1_Марина_Тепло")
(link-goto: "Отделаться вежливыми фразами и уйти в дом", "День1_Марина_Холодно")
</div>

:: День1_Марина_Тепло
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%9C%D0%B0%D1%80%D0%B8%D0%BD%D0%B0%20%D0%A2%D0%B5%D0%BF%D0%BB%D0%BE.png')";</script>
(set: $readiness to $readiness + 5)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Как ты вообще? Всё ещё в поликлинике?</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Веду терапевтический приём, представляешь. А мечтала о хирургии.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Жизнь вносит коррективы.</p></div>

<div class="narration">Марина ловит твой взгляд и на секунду отводит глаза — будто испугалась, что ты успела что-то в нём прочитать.</div>

<div class="dialogue"><span class="speaker">Марина</span><p class="line">Если что понадобится — я всё там же, через два дома.</p></div>

<div class="choices">
(link-goto: "Наступает ночь...", "День1_Ночь")
</div>

:: День1_Марина_Холодно
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%9C%D0%B0%D1%80%D0%B8%D0%BD%D0%B0%20%D1%85%D0%BE%D0%BB%D0%BE%D0%B4%D0%BD%D0%BE.png')";</script>
(set: $distortion to $distortion + 5)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Извини, мне ещё дом разбирать. Давай в другой раз.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Да, конечно... Как скажешь.</p></div>

<div class="narration">Ты киваешь, улыбаешься дежурно и уходишь в дом при первой же возможности. Легче не разговаривать. Легче не вспоминать.</div>

<div class="choices">
(link-goto: "Наступает ночь...", "День1_Ночь")
</div>

:: День1_Ночь
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%201%20%D0%BD%D0%BE%D1%87%D1%8C.jpg')";</script>
<h2>Ночь 1</h2>

<div class="narration">Дом внутри меньше, чем ты помнишь, и одновременно неправильно больше — будто за годы отсутствия в нём выросли лишние метры темноты. Уже почти засыпая, ты слышишь скрип половиц в конце коридора — размеренный, как шаги. Дверь в запертую комнату не поддаётся.</div>

<div class="narration">На автоответчике в кабинете отца горит одна непрослушанная запись.</div>

<div class="dialogue"><span class="speaker">Голос отца</span><p class="line voice">Ещё немного. Я почти готов сказать.</p></div>

<div class="narration">Дата записи — двенадцать дней назад. Отец умер три недели назад.</div>

<div class="choices">
(link-goto: "Прослушать запись ещё раз, вслушаться в каждое слово", "День1_Автоответчик_Слушать")
(link-goto: "Списать на неисправность техники и лечь спать", "День1_Автоответчик_Игнор")
</div>

:: День1_Автоответчик_Слушать
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%201%20%D0%B0%D0%B2%D1%82%D0%BE%D0%BE%D1%82%D0%B2%D0%B5%D1%82%D1%87%D0%B8%D0%BA%20%D1%81%D0%BB%D1%83%D1%88%D0%B0%D1%82%D1%8C.png')";</script>
(set: $readiness to $readiness + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Ещё раз. Что ты пытался сказать?</p></div>

<div class="narration">Ты слушаешь запись три раза подряд. Голос не меняется, но с каждым разом тебе всё яснее слышится, что отец обращается не к тебе и не к Лизе. Он говорит с домом.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День2_День")
</div>

:: День1_Автоответчик_Игнор
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%201%20%D0%B0%D0%B2%D1%82%D0%BE%D0%BE%D1%82%D0%B2%D0%B5%D1%82%D1%87%D0%B8%D0%BA%20%D0%B8%D0%B3%D0%BD%D0%BE%D1%80.png')";</script>
(set: $distortion to $distortion + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Просто старая техника. Ничего страшного.</p></div>

<div class="narration">Ты выключаешь аппарат и ложишься спать, так и не сомкнув глаз до конца ночи.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День2_День")
</div>

:: День2_День
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%20%D0%B4%D0%B2%D0%B0%20%D1%81%D0%BE%D1%81%D0%B5%D0%B4%D0%B8.png')";</script>
<h2>День 2 — Соседи</h2>

<div class="narration">Ты обходишь соседей. Большинство вежливо и коротко выражают соболезнования и меняют тему. Только бывшая учительница, Зоя Павловна, задерживает тебя дольше остальных.</div>

<div class="dialogue"><span class="speaker">Зоя Павловна</span><p class="line">Полиция тогда как-то слишком быстро успокоилась, не находишь? Для дела о пропавшем ребёнке...</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Что вы имеете в виду?</p></div>

<div class="choices">
(link-goto: "Надавить, спросить прямо, что она имеет в виду", "День2_Учительница_Давить")
(link-goto: "Поблагодарить и не развивать тему — слишком личное", "День2_Учительница_Уйти")
</div>

:: День2_Учительница_Давить
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%20%D0%B4%D0%B2%D0%B0%20%D0%BD%D0%B0%D0%B4%D0%B0%D0%B2%D0%B8%D1%82%D1%8C.png')";</script>
(set: $readiness to $readiness + 5)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Пожалуйста, скажите прямо. Мне нужно знать.</p></div>
<div class="dialogue"><span class="speaker">Зоя Павловна</span><p class="line">Он до сих пор этим живёт, представь. Позвони детективу Орлову — вот его номер.</p></div>

<div class="choices">
(link-goto: "Наступает ночь...", "День2_Ночь")
</div>

:: День2_Учительница_Уйти
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%20%D0%B4%D0%B2%D0%B0%20%D1%83%D0%B9%D1%82%D0%B8.png')";</script>
(set: $distortion to $distortion + 5)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Мне это неинтересно, если честно.</p></div>
<div class="dialogue"><span class="speaker">Зоя Павловна</span><p class="line">Как знаешь. Вот, кстати, возьми на всякий случай — номер детектива Орлова.</p></div>

<div class="narration">Она всё же успевает продиктовать его напоследок — привычка старой учительницы договаривать начатое.</div>

<div class="choices">
(link-goto: "Наступает ночь...", "День2_Ночь")
</div>

:: День2_Ночь
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%202%20%D0%BD%D0%BE%D1%87%D1%8C.jpg')";</script>
<h2>Ночь 2</h2>

<div class="narration">Дневник отца — толстая клеёнчатая тетрадь. Записи обрываются на дате его смерти. А потом начинаются снова, тем же почерком, только более дрожащим.</div>

<div class="dialogue"><span class="speaker">Голос отца</span><p class="line voice">Сегодня опять скрипела половица у её комнаты. Я говорю ей — подожди ещё немного, подожди Аню.</p></div>

<div class="choices">
(link-goto: "Прочитать дневник целиком, не пропуская страниц", "День2_Дневник_Полностью")
(link-goto: "Пролистать по диагонали — слишком тяжело читать подробно", "День2_Дневник_Бегло")
</div>

:: День2_Дневник_Полностью
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%20%D0%B4%D0%B2%D0%B0%20%D0%BF%D0%BE%D0%BB%D0%BD%D0%BE%D1%81%D1%82%D1%8C%D1%8E.jpg')";</script>
(set: $readiness to $readiness + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Нет. Читаю всё, до конца — сколько бы это ни стоило.</p></div>

<div class="narration">Ты читаешь до утра. Где-то на середине тебе кажется, что коридор наверху стал длиннее — двери, которых там быть не должно. К утру всё снова как обычно.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День3_День")
</div>

:: День2_Дневник_Бегло
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%202%20%D0%B4%D0%BD%D0%B5%D0%B2%D0%BD%D0%B8%D0%BA%20%D0%B1%D0%B5%D0%B3%D0%BB%D0%BE.jpg')";</script>
(set: $distortion to $distortion + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Не сегодня. Не могу читать это подробно.</p></div>

<div class="narration">Ты пролистываешь страницы, стараясь не вчитываться в детали. Проще не знать. Проще думать, что это просто старческая спутанность.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День3_День")
</div>

:: День3_День
<script>document.body.style.backgroundImage = "url('https://raw.githubusercontent.com/SamZeitgeist/Visual-novel/main/%D0%B4%D0%B5%D0%BD%D1%8C%203%20%D0%B4%D0%B5%D0%BD%D1%8C.jpg')";</script>
<h2>День 3 — Орлов</h2>

<div class="narration">Квартира Орлова — архив, отказавшийся умирать вместе с делом.</div>

<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Дело закрыли слишком быстро. Официально — «за отсутствием оснований». Я написал два рапорта. Оба легли под сукно.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Почему?</p></div>
<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Твой отец дружил не с теми людьми, Аня. В этом доме было тяжелее, чем все тогда думали.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Что вы имеете в виду?</p></div>

(set: $readiness to $readiness + 10)

<div class="narration">Он не договаривает. Ты не переспрашиваешь — пока не готова услышать ответ.</div>

<div class="choices">
(link-goto: "Наступает ночь...", "День3_Ночь")
</div>

:: День3_Ночь
<h2>Флэшбек. Лето, 2011</h2>

<div class="narration">Чердак. Карты на желания. Лизе девять, тебе тринадцать. Она смеётся так, что у неё сводит живот.</div>

<div class="dialogue"><span class="speaker">Лиза</span><p class="line">Если проиграешь — будешь весь вечер звать меня «ваше величество».</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Не дождёшься.</p></div>

<div class="narration">В какой-то момент она вдруг спускается вниз, к телефону. Ты слышишь через люк обрывок разговора — шёпот, взрослый не по годам. Единственное разборчивое слово — «обещаю», повторённое дважды.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">С кем ты говорила?</p></div>
<div class="dialogue"><span class="speaker">Лиза</span><p class="line">Ни с кем. Не твоё дело.</p></div>
<div class="dialogue"><span class="speaker">Лиза</span><p class="line">Ты всё равно не поймёшь.</p></div>

<div class="narration">Ты просыпаешься с ощущением, что снова, как и пятнадцать лет назад, не успела удержать что-то важное.</div>

<div class="choices">
(link-goto: "Дальше", "День4_День")
</div>

:: День4_День
<h2>День 4 — Комната Лизы</h2>

<div class="narration">Марина заходит на чай — сама, без приглашения, что на неё не похоже.</div>

<div class="dialogue"><span class="speaker">Марина</span><p class="line">Я кое-что видела в ту ночь. Но это неважно, Аня. Правда неважно.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Что именно ты видела?</p></div>

<div class="choices">
(link-goto: "Надавить прямо сейчас, потребовать ответа", "День4_Марина_Давить")
(link-goto: "Не давить — дать ей время", "День4_Марина_Терпение")
</div>

:: День4_Марина_Давить
{(if: $readiness < 30)[
(set: $distortion to $distortion + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Скажи сейчас же. Хватит недомолвок.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Не сейчас.</p></div>

<div class="narration">Марина сжимается, будто ты ударила её словами, и уходит, не допив чай. Кажется, ты надавила слишком рано.</div>
](else:)[
(set: $readiness to $readiness + 5)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Марина, пожалуйста. Мне правда нужно знать.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Не сейчас. Ещё не время.</p></div>

<div class="narration">Но она не уходит сразу — остаётся ещё на несколько минут, будто что-то взвешивая.</div>
]}

<div class="choices">
(link-goto: "Наступает ночь...", "День4_Ночь")
</div>

:: День4_Марина_Терпение
(set: $readiness to $readiness + 3)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Ладно. Расскажешь, когда будешь готова.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Спасибо.</p></div>

<div class="choices">
(link-goto: "Наступает ночь...", "День4_Ночь")
</div>

:: День4_Ночь
<h2>Ночь 4 — Комната Лизы</h2>

<div class="narration">Замок поддаётся неожиданно легко. Внутри всё стоит как в то последнее лето. У самой двери — собранный дорожный чемодан. Пыльный, нетронутый, застёгнутый на все замки.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Сбежавшие не оставляют вещи...</p></div>

<div class="choices">
(link-goto: "Осмотреть чемодан внимательно", "День4_Чемодан_Смотреть")
(link-goto: "Закрыть комнату и уйти — слишком тяжело", "День4_Чемодан_Уйти")
</div>

:: День4_Чемодан_Смотреть
(set: $readiness to $readiness + 10)

<div class="narration">Ты опускаешься на колени перед чемоданом.</div>

<div class="dialogue"><span class="speaker">Голос</span><p class="line voice">Ты обещала.</p></div>

<div class="narration">Ты не двигаешься, пока голос не стихает сам.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День5_День")
</div>

:: День4_Чемодан_Уйти
(set: $distortion to $distortion + 10)

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Не сегодня.</p></div>

<div class="narration">Ты закрываешь дверь, не тронув замков.</div>

<div class="dialogue"><span class="speaker">Голос</span><p class="line voice">Ты обещала.</p></div>

<div class="narration">Ты идёшь быстрее, не оборачиваясь.</div>

(display: "SymptomFooter")

<div class="choices">
(link-goto: "Дальше", "День5_День")
</div>

:: День5_День
<h2>День 5 — Трещины</h2>

{(if: $readiness >= 40)[
<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Вот. Формулировка — «по результатам ведомственной проверки». Подпись — человека, ныне занимающего высокий пост в администрации города.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Это ведь ничего не доказывает.</p></div>
<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Доказывает, что кто-то очень не хотел, чтобы мы копали дальше. Не доказывает — почему.</p></div>

(set: $readiness to $readiness + 10)
](else:)[
<div class="narration">Орлов не выходит на связь два дня подряд — «занят», отвечает секретарь на автоответчике его домашнего телефона. Ты остаёшься наедине с домом и собственными сомнениями чуть дольше, чем рассчитывала.</div>

(set: $distortion to $distortion + 5)
]}

<div class="choices">
(link-goto: "Наступает ночь...", "День5_Ночь")
</div>

:: День5_Ночь
<h2>Флэшбек. Конец лета, 2011</h2>

<div class="dialogue"><span class="speaker">Лиза</span><p class="line">Я расскажу маме. Кто-нибудь должен наконец узнать про отца!</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Подожди! Если ты расскажешь — нас заберут в разные семьи!</p></div>
<div class="dialogue"><span class="speaker">Лиза</span><p class="line">Отпусти!</p></div>

{(if: $readiness > $distortion)[
<div class="narration">Ты помнишь эту секунду отчётливо: дверь держала ты сама, обеими руками, не давая ей спуститься вниз.</div>
](else:)[
<div class="narration">Картинка размыта: кажется, дверь просто захлопнулась сама, от сквозняка, а ты лишь стояла рядом.</div>
]}

<div class="narration">Дальше — обрыв. Плёнка обрезана в самом важном месте.</div>

<div class="narration">Ты просыпаешься в коридоре второго этажа, у стены, которой там никогда не было. За ней — проход вниз, к глухой стене подвала. К утру прохода нет. Но ты запомнила, куда он вёл.</div>

<div class="choices">
(link-goto: "Дальше", "День6_День")
</div>

:: День6_День
<h2>День 6 — Марина и ниша</h2>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Что ты видела в ту ночь, Марина? Всё, полностью.</p></div>

{(if: $readiness >= 45)[
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Я видела тебя. Бежала за ней к дому, с фонариком. А потом ты вернулась одна, и свет в доме погас.</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Почему ты молчала пятнадцать лет?</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Я была влюблена в твоего отца. Вот почему.</p></div>

(set: $readiness to $readiness + 15)
](else:)[
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Не сейчас, Аня. Правда, не сейчас.</p></div>

<div class="narration">Марина явно хочет закончить разговор как можно быстрее. Ты понимаешь, что откровенного ответа сегодня не будет.</div>

(set: $distortion to $distortion + 10)
]}

<div class="choices">
(link-goto: "Наступает ночь...", "День6_Ночь")
</div>

:: День6_Ночь
<h2>Ночь 6 — Лестница</h2>

<div class="narration">Заколоченный вход в подвал наконец поддаётся — только сама лестница, ниша в стене ещё замурована. Орлов приезжает сам, без звонка.</div>

<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Разберём вместе. Ты не должна делать это одна.</p></div>

<div class="narration">Это последний момент, когда можно остановиться.</div>

<div class="choices">
(link-goto: "Согласиться — разобрать стену завтра утром", "День7_Согласие")
(link-goto: "Попросить его уйти — стену не трогать", "Финал_Отрицание")
</div>

:: День7_Согласие
<h2>День 7 — Ниша</h2>

<div class="narration">Утро тихое, почти нарисованное. Вы стоите втроём у входа в подвал: ты, Орлов и неожиданно пришедшая сама Марина.</div>

<div class="narration">Кладка старая, наспех сделанная — не мастером, а человеком, который делал это в спешке, ночью, дрожащими руками. Орлов работает молотком методично. Когда последний кирпич падает на бетонный пол, из ниши будто выдыхает пятнадцать лет тишины.</div>

<div class="choices">
(link-goto: "Заглянуть внутрь", "Финал_Развилка")
</div>

:: Финал_Развилка
{(if: $distortion >= 60 and $readiness >= 60)[
(display: "Финал_Плохой")
](else-if: $readiness > $distortion)[
(display: "Финал_Признание")
](else:)[
(display: "Финал_Признание_Неполное")
]}

:: Финал_Признание
<h2>Финал — «Признание»</h2>

<div class="narration">Ты наконец вспоминаешь то, что память так старательно вырезала из плёнки той ночи.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Я держала дверь. Я не отпускала её руку, когда она вырывалась.</p></div>

<div class="narration">Она сорвалась вниз, до последней секунды борясь за право уйти к телефону, к правде. Отец нашёл вас обеих раньше, чем успела бы приехать скорая. И вместо того чтобы спасти правду, он спас единственное, что у него оставалось — тебя.</div>

<div class="dialogue"><span class="speaker">Голос</span><p class="line voice">...</p></div>

<div class="narration">Голос дома стихает в ту же секунду навсегда — не потому что его прогнали, а потому что ему больше нечего скрывать.</div>

<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Я всё оформлю как надо. Пятнадцать лет ждал этого звонка.</p></div>
<div class="dialogue"><span class="speaker">Марина</span><p class="line">Я рядом. Что бы ни случилось дальше.</p></div>

<div class="narration">Ты знаешь, что дальше будет тяжело: следователи, журналисты, разрушенная память об отце. Но впервые за пятнадцать лет, ложась спать в ту ночь, ты не слышишь скрипа половиц за спиной.</div>

<div class="narration"><b>КОНЕЦ.</b> Дом отпустил тебя — не потому что ты его победила, а потому что тебе больше не нужно прятаться внутри отрицания вместе с ним.</div>

<div class="choices">
(link-goto: "Начать заново", "Start")
</div>

:: Финал_Признание_Неполное
<h2>Финал — «Признание» (неполное)</h2>

<div class="narration">Правда открывается — чемодан, ниша, останки — но твоя собственная память так и не сдаётся до конца. Ты знаешь факты, но не можешь заставить себя произнести вслух, что дверь держала именно ты.</div>

<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Аня... тебе плохо?</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Просто... дайте мне минуту.</p></div>

<div class="narration">Орлов и Марина видят твоё лицо и не задают вопросов, на которые, кажется, сами боятся получить ответ. Дело открывают заново — уже без твоих показаний, только по найденным останкам и документам Орлова. Городок гудит слухами. Ты уезжаешь, так и не признав вслух того единственного, что действительно имело значение.</div>

<div class="narration">Дом больше не говорит с тобой голосами. Но иногда, среди ночи, тебе всё ещё снится скрип половиц — уже без адреса, без дома, просто привычка, которую пятнадцать лет назад начал твой собственный рассудок.</div>

<div class="choices">
(link-goto: "Начать заново", "Start")
</div>

:: Финал_Отрицание
<h2>Финал — «Отрицание»</h2>

<div class="narration">Ты не спишь всю ночь перед назначенным утром — не от страха темноты, а от куда более тихого страха того, что покажет стена.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Я передумала. Не будем ничего трогать.</p></div>
<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Аня, ты уверена?</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Уверена.</p></div>

<div class="narration">Он не спорит, хотя в его голосе слышно разочарование пятнадцати лет ожидания. Марина, узнав об этом, не скрывает облегчения.</div>

<div class="narration">В комнате Лизы ты снова находишь чемодан. На этот раз не открываешь его — просто откладываешь к вещам на сожжение. Среди старых бумаг на дне, впрочем, замечаешь маленький кулон на потемневшей цепочке — и, не отдавая себе отчёта зачем, кладёшь его в карман куртки.</div>

<div class="narration">Голос дома в последнюю неделю больше не звучит ни разу. Дом словно сдался, устав ждать от тебя того, чего ты не готова дать. Дом продают через два месяца. Ты уезжаешь, так и не узнав правды.</div>

<div class="narration">Проходит почти десять лет. У тебя есть своя дочь — восемь лет, любопытная не по годам. Однажды, разбирая старую куртку, она находит в кармане забытый кулон с гравировкой «Л».</div>

<div class="dialogue"><span class="speaker">Дочь</span><p class="line">Мама, а у меня была тётя? Кто такая тётя Лиза?</p></div>
<div class="dialogue"><span class="speaker">Аня</span><p class="line">Старая история. Расскажу как-нибудь потом, когда подрастёшь.</p></div>

<div class="narration">Вы обе не знаете, что «потом» может так и не наступить.</div>

<div class="narration"><b>КОНЕЦ.</b></div>

<div class="choices">
(link-goto: "Начать заново", "Start")
</div>

:: Финал_Плохой
<h2>Финал — «Плохой»</h2>

<div class="narration">Ты опускаешься на колени перед нишей — и память возвращается не частями, а разом, одним оглушительным ударом, который рассудок просто не рассчитан выдерживать.</div>

<div class="dialogue"><span class="speaker">Аня</span><p class="line">Я держала дверь. Она вырывалась. Она упала.</p></div>

<div class="narration">Но одновременно с этим в голове звучит и другая версия: дверь держала не ты, всё было просто нелепой случайностью. Обе версии одинаково реальны. Обе требуют, чтобы ты выбрала одну и отпустила вторую. Ты не можешь выбрать.</div>

<div class="dialogue"><span class="speaker">Орлов</span><p class="line">Аня? Аня, ты меня слышишь?</p></div>

<div class="narration">Его голос доносится будто сквозь толщу воды, замедленный, искажённый. Стены подвала на секунду перестают быть стенами подвала — то детская комната, то чердак, то автовокзал, где Лизы никогда не было.</div>

<div class="dialogue"><span class="speaker">Дом</span><p class="line voice">Ты знала. Ты держала дверь. Ты никогда не отпустишь это, потому что тогда придётся признать, кем ты была в ту секунду. А если не отпустишь — тебе некуда будет от этого уйти, кроме как остаться здесь, со мной, где хотя бы не нужно выбирать.</p></div>

<div class="narration">Орлов и Марина выносят из подвала тело — то, что ещё дышит, у чего ещё бьётся сердце. Врачи скорой опишут это как острое диссоциативное состояние. Тело выпишут через несколько месяцев.</div>

<div class="narration">Но ты — та часть, что помнила карты на чердаке и голос отца на автоответчике — остаёшься в доме. По-настоящему. В единственном смысле, какой ещё имеет для тебя значение.</div>

<div class="narration">Дом продают через год новой семье. В первую же ночь их маленький сын слышит в стене тихий, размеренный скрип половиц.</div>

<div class="dialogue"><span class="speaker">???</span><p class="line voice">Дом стоит пустой пятнадцать лет...</p></div>

<div class="narration"><b>КОНЕЦ.</b></div>

<div class="choices">
(link-goto: "Начать заново", "Start")
</div>
